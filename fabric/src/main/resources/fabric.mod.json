{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_display_name}",
  "description": "${mod_description}",
  "authors": [ "${mod_authors}" ],
  "contact": {
    "homepage": "${mod_homepage}",
    "issues": "${mod_issues}",
    "sources": "${mod_source}"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/${mod_logo}",
  "environment": "*",
  "entrypoints": {
    "preLaunch": [ "com.${mod_id}.NetworkBootstrap" ],
    "main": [ "com.${mod_id}.Initializer" ],
    "client": [ "com.${mod_id}.ClientInitializer" ],
    "modmenu": [ "com.${mod_id}.compat.modmenu.MajruszsDifficultyModMenu" ]
  },
  "mixins": [
    "${mod_id}-common.mixins.json",
    "${mod_id}-fabric.mixins.json"
  ],
  "depends": {
    "fabric": "*",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=21",
    "oelib": ">=0.3.0-SNAPSHOT"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "update": "${mod_update}"
  }
}
